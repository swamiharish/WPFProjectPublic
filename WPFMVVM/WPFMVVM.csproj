<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\adult.png" />
    <None Remove="Images\child.png" />
    <None Remove="Images\Senior.png" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>



  <ItemGroup>
    <Resource Include="Images\adult.png" />
    <Resource Include="Images\child.png" />
    <Resource Include="Images\Senior.png" />
  </ItemGroup>

</Project>
