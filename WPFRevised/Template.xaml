<Window x:Class="WPFRevised.Template"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRevised"
        mc:Ignorable="d"
        Title="Template" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <!--<Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>-->
           
        </Style>
        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Grid>
                <Ellipse Fill="AliceBlue"></Ellipse>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid>

        <Button Content="Click Me" HorizontalAlignment="Center" Template="{StaticResource ButtonTemplate}" VerticalAlignment="Center">
            <!--<Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="AliceBlue"></Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
         </Button.Template>-->
     </Button>

        <Label Width="150" Height="30" Content="{Binding Person}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label.ContentTemplate>
                <DataTemplate>
                    <Label Content="{Binding Name}" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
                <!--<DataTemplate>
                    <StackPanel Orientation="Horizontal" Width="150" Height="30">
                        <TextBox Text="{Binding Name,Mode=TwoWay}" Margin="5"/>

                    </StackPanel>
                </DataTemplate>-->
            </Label.ContentTemplate>
        </Label>

    </Grid>
</Window>
