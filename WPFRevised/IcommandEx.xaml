<Window x:Class="WPFRevised.IcommandEx"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRevised"
        mc:Ignorable="d"
        Title="IcommandEx" Height="450" Width="800">
    <Window.Resources>
        <local:MyCommand x:Key="MyCommand"/>

    </Window.Resources>
    <StackPanel>
        <TextBox x:Name="InputTextBox" Width="200" Margin="10"/>
        <Button Content="Click Me" Width="100" Margin="10" Command="{Binding Source={StaticResource MyCommand}}" CommandParameter="{Binding Text, ElementName=InputTextBox}"/>
    </StackPanel>
</Window>
