<Window x:Class="WPFRevised.ResourceStyles"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRevised"
        mc:Ignorable="d"
        Title="ResourceStyles" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="LavenderBlush"/>
        <Style  TargetType="Button">
           <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            
        </Style>
       
    </Window.Resources>
    <Grid>
      <Button Content="Click Me" Background="{StaticResource PrimaryBrush}" Click="Button_Click" />
       <Button Content="Click Me Too" Background="{DynamicResource MyButtonStyle}" Margin="0,50,0,0"/>

    </Grid>
</Window>
