<Window x:Class="WPFRevised.StylesTriggers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRevised"
        mc:Ignorable="d"
        Title="StylesTriggers" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DefaultButtonStyle">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
        </Style>    
    </Window.Resources>
    <StackPanel Orientation="Vertical">

        <Button Content="Click Me" Background="LavenderBlush" Click="Button_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="LightBlue"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            </Button.Style>
        </Button>
        <CheckBox x:Name="checkBoxone" Content="Check Me" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Content="Click Me Too"  Margin="0,10,0,0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=checkBoxone, Path=IsChecked}" Value="True">
                            <Setter Property="Background" Value="LightCoral"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</Window>
